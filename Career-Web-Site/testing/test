<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Centered Flexible Grid</title>
    <style>
      /* Container setup */
      .centered-list {
        display: flex;
        flex-wrap: wrap; /* Wraps items onto new lines as needed */
        justify-content: center; /* Centers items horizontally on each row */
        gap: 7px; /* Space between items horizontally and vertically */
        list-style: none; /* Removes default list bullet points */
        padding: 0;
        margin: 0 auto;
        max-width: 1200px; /* Optional: Limit overall max width */
      }

      /* Individual item styling */
      .list-item {
        /* Adjust width or flex-basis depending on your content size */
        width: 150px;
        height: 100px;

        /* Visual styling for demo */
        background-color: rgba(59, 130, 246, 1);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        font-weight: 600;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease;
      }

      .list-item:hover {
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <ul class="centered-list">
      <li class="list-item">Item 1</li>
      <li class="list-item">Item 2</li>
      <li class="list-item">Item 3</li>
      <li class="list-item">Item 4</li>
      <li class="list-item">Item 5</li>
      <li class="list-item">Item 6</li>
      <li class="list-item">Item 7</li>
      <li class="list-item">Item 8</li>
      <li class="list-item">Item 9</li>
      <li class="list-item">Item 10</li>
    </ul>
  </body>
</html>
